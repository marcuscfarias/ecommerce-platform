<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(StoreShell)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(StoreShell)">
            <NotFoundPage />
        </LayoutView>
    </NotFound>
</Router>
