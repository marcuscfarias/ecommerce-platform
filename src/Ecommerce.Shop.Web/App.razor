<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(StoreShell)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(StoreShell)">
            <NotFoundPage />
        </LayoutView>
    </NotFound>
</Router>

@* Outside the router: the notice has to reach the visitor even when no route or layout has rendered. *@
<ColdStartAlert />
