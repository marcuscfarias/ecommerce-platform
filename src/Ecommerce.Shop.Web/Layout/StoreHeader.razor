@implements IDisposable
@inject AuthApiClient AuthApi
@inject AuthenticationStateProvider AuthState
@inject ProfileState Profiles
@inject NavigationManager Navigation

<header class="store-header">
    <div class="store-header__inner">
        <a class="wordmark" href="/">
            ecommerce
            <span class="wordmark__tag">store</span>
        </a>

        <div class="store-header__actions">
            <AuthorizeView>
                <Authorized>
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <ActivatorContent Context="menu">
                            <button type="button" class="store-action store-action--live store-action--account" aria-haspopup="menu"
                                    @onclick="args => menu.ToggleAsync(args)">
                                <MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Class="store-action__icon" />
                                <span class="store-action__text">
                                    <span class="store-action__hint">@Greeting</span>
                                    <span class="store-action__label">Account &amp; Lists</span>
                                </span>
                            </button>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem Href="account">Your account</MudMenuItem>
                            <MudMenuItem OnClick="SignOutAsync">Sign out</MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </Authorized>
                <NotAuthorized>
                    @SignInLink
                </NotAuthorized>
                <Authorizing>
                    @SignInLink
                </Authorizing>
            </AuthorizeView>

            <div class="store-action store-action--cart" aria-disabled="true" title="The cart arrives in a later release">
                <span class="cart-badge">0</span>
                <span class="store-action__label">Cart</span>
            </div>
        </div>
    </div>
</header>

@code {
    private string Greeting => Profiles.Current is { } profile ? $"Hello, {profile.DisplayName}" : "Hello";

    private RenderFragment SignInLink =>
        @<a class="store-action store-action--live store-action--account" href="account/login">
            <MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Class="store-action__icon" />
            <span class="store-action__text">
                <span class="store-action__hint">Hello, sign in</span>
                <span class="store-action__label">Account &amp; Lists</span>
            </span>
        </a>;

    protected override async Task OnInitializedAsync()
    {
        Profiles.Changed += OnProfileChanged;
        AuthState.AuthenticationStateChanged += OnAuthenticationStateChanged;

        await LoadProfileAsync(AuthState.GetAuthenticationStateAsync());
    }

    public void Dispose()
    {
        Profiles.Changed -= OnProfileChanged;
        AuthState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private void OnProfileChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnAuthenticationStateChanged(Task<AuthenticationState> state) => _ = LoadProfileAsync(state);

    private async Task LoadProfileAsync(Task<AuthenticationState> state)
    {
        if ((await state).User.Identity?.IsAuthenticated == true)
        {
            await Profiles.EnsureLoadedAsync();
        }
    }

    private async Task SignOutAsync()
    {
        await AuthApi.LogoutAsync();
        ((CookieAuthenticationStateProvider)AuthState).NotifyStateChanged();
        Navigation.NavigateTo("/");
    }
}
