<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
            <Authorizing>
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            </Authorizing>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <MudText Typo="Typo.h5" Class="pa-8">Page not found.</MudText>
        </LayoutView>
    </NotFound>
</Router>

@* Outside the router: the sign-in screen sits in AuthorizeRouteView's Authorizing state until
   /auth/me answers, so a notice inside the layout would never render during a cold start. *@
<ColdStartAlert />
